# ============================================================
# VersionVault — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# See docs/TECH_LEAD_SERVICES.md for the full setup guide.
# ============================================================

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# ============================================================
# SUPABASE — AUTH + DATABASE + PRIVATE STORAGE
# Get these from your Supabase project settings > API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — NEVER prefix with NEXT_PUBLIC_
# Used only in server-side service clients (never browser)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# OPENROUTER — SERVER ONLY
# https://openrouter.ai/keys
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ============================================================
# REDIS — SERVER/WORKER ONLY (only required if queue is used)
# ============================================================
REDIS_URL=

# ============================================================
# GOOGLE OAUTH — ONLY IF ENABLED
# ============================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
